{
  "rewrites": [
    {
      "source": "/api/oauth/token",
      "destination": "https://api.wytnet.com/oauth/token"
    },
    {
      "source": "/api/oauth/userinfo",
      "destination": "https://api.wytnet.com/oauth/userinfo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
